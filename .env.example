# Environment Variables Template for Loan Settlement Expert Next.js Application

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://loansettlementexpert.in

# Optional Webhook for Leads / CRM Integration (e.g. Zoho CRM, Zapier, Webhook Relay)
CRM_WEBHOOK_URL=https://flow.zoho.in/your-lead-webhook-url
LEAD_WEBHOOK_URL=

# Optional Notification Email Configuration (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=info@loansettlementexpert.in
SMTP_PASS=your-secure-password
NOTIFICATION_RECEIVER=info@loansettlementexpert.in
